# ---------------------------------------------------------------------------
# AegisCode environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Client (safe to expose, injected into the browser bundle) -------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Server only (never prefix these with VITE_) ---------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"

# OpenRouter is the only AI provider in the request path.
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxx"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct"

# Firecrawl is called directly, server-side only.
FIRECRAWL_DIRECT_API_KEY="fc-xxxxxxxxxxxxxxxxxxxx"
